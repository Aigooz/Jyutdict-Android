<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:clipToPadding="false"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/audio_book_reading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/clockTextColor"
            android:textSize="14sp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/audio_book_definition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/clockTextColorDim"
            android:textSize="13sp"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/taishan_audio_source_credit"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/audio_reference_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/clockTextColorDim"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/audio_candidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

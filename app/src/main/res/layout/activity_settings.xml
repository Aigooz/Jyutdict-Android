<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/clockBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Jyutdict.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/title_activity_settings" />

    <FrameLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="?attr/cardBackground"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_check_version"
                style="@style/ButtonTextColor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#00000000"
                android:foreground="?selectableItemBackground"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="20dp"
                android:text="@string/app_version"
                android:textColor="?attr/clockTextColor"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="?attr/clockHover" />

            <Button
                android:id="@+id/btn_about"
                style="@style/ButtonTextColor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#00000000"
                android:foreground="?selectableItemBackground"
                android:gravity="end|center_vertical"
                android:paddingHorizontal="20dp"
                android:text="@string/about_entry"
                android:textAllCaps="false"
                android:textColor="?attr/clockTextColorDim"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

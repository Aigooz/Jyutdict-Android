<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card_ripple"
    android:elevation="2dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/taishan_headword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:textColor="?attr/clockTextColor"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="日头" />

        <TextView
            android:id="@+id/taishan_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="?attr/clockTextColorDim"
            android:textSize="12sp"
            tools:text="原書 1 頁" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/taishan_ipa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/clockAccentColor"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="ŋit³¹heu²¹" />

            <TextView
                android:id="@+id/taishan_audio_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:textColor="?attr/clockTextColorDim"
                android:textSize="12sp"
                android:text="@string/taishan_audio_missing" />
        </LinearLayout>

        <include layout="@layout/pronunciation_control" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/taishan_audio_manage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_audio_attach_24"
            android:contentDescription="@string/taishan_audio_manage" />

    </LinearLayout>

    <TextView
        android:id="@+id/taishan_definition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:lineSpacingExtra="2dp"
        android:textColor="?attr/clockTextColor"
        android:textSize="15sp"
        tools:text="太阳。" />

    <TextView
        android:id="@+id/taishan_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/clockTextColorDim"
        android:textSize="12sp"
        tools:text="一、天文 · （1）天空" />

</LinearLayout>

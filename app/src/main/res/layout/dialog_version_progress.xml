<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_update_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/version_progress_title"
        android:textColor="?attr/clockTextColor"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/version_progress_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/colorPrimary"
        android:textSize="34sp"
        android:textStyle="bold"
        tools:text="42%" />

    <ProgressBar
        android:id="@+id/version_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/colorPrimary"
        android:progressBackgroundTint="?attr/clockHover"
        android:progressTint="@color/colorPrimary" />

    <TextView
        android:id="@+id/version_progress_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/version_download_preparing"
        android:textColor="?attr/clockTextColorDim"
        android:textSize="13sp"
        tools:text="12.3 MB / 45.6 MB" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/version_progress_cancel"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_outline_button"
        android:foreground="?selectableItemBackground"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="@string/button_cancel"
        android:textAllCaps="false"
        android:textColor="?attr/clockTextColor"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>

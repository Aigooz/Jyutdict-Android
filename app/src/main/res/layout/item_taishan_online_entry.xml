<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card_ripple"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/online_headword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:textColor="?attr/clockTextColor"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="台山話" />

    <TextView
        android:id="@+id/online_ipa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="?attr/clockAccentColor"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="[hɔi22 san33 va325]" />

    <TextView
        android:id="@+id/online_equivalents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/clockTextColorDim"
        android:textSize="13sp"
        tools:text="粵語：台山話　普通話：台山话" />

    <TextView
        android:id="@+id/online_english"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="?attr/clockTextColor"
        android:textSize="14sp"
        tools:text="Taishanese dialect" />

    <TextView
        android:id="@+id/online_definition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:lineSpacingExtra="2dp"
        android:textColor="?attr/clockTextColor"
        android:textSize="14sp"
        tools:text="Description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/online_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/taishan_online_credit"
            android:textColor="?attr/clockTextColorDim"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/online_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/taishan_online_play"
            android:padding="12dp"
            android:src="@drawable/ic_volume_24" />
    </LinearLayout>

</LinearLayout>
